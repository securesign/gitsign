{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>securesign/renovate-config//org-inherited-config.json"
  ],
  "enabledManagers": ["dockerfile", "gomod", "tekton", "custom.regex"],
  "ignorePaths": [
    ".github/workflows/**",
    ".goreleaser.yaml",
    "contrib/**"
  ],
  "packageRules": [
    {
      "description": "Disable GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "enabled": false
    },
    {
      "description": "Disable updates for upstream-only Docker images",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "cgr.dev/chainguard/git"
      ],
      "enabled": false
    }
  ]
}
